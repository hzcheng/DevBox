PROJECT_NAME=DevBox

# Set to "true" to use mainland China mirrors for faster builds
# This affects: apt sources, npm registry, Go downloads, GitHub releases
USE_CN_MIRROR=false

# Build target in devbox/Dockerfile.
# devbox:     standard image with codewiz proxy (default)
# devbox-red: Xiaohongshu extras, also includes the codewiz proxy
DOCKER_BUILD_TARGET=devbox

# Proxy used during Docker build (e.g., http://192.168.1.100:7890)
# Leave empty to use no proxy during build
BUILD_PROXY=

# Proxy used inside the running container (e.g., http://192.168.1.100:7890)
# Leave empty to use no proxy at runtime
RUNTIME_PROXY=

# Domains/IPs to exclude from proxy at runtime (comma-separated, e.g., localhost,127.0.0.1,.local)
NO_PROXY=

# Optional CPU architecture override. Leave empty to use Docker's default target.
# Supported values: amd64 or arm64
ARCH=

# Keep this as latest to install the newest available code-server on startup.
# You can still pin an exact version here when needed.
CODE_SERVER_VERSION=latest

# Optional mirror for code-server release downloads during Docker build
CODE_SERVER_RELEASE_BASE_URL=https://github.com/coder/code-server/releases/download

# Enable daily code-server update checks when CODE_SERVER_VERSION=latest.
CODE_SERVER_AUTO_UPDATE=true

# Interval between update checks in seconds (86400 = 24 hours).
CODE_SERVER_UPDATE_INTERVAL_SECONDS=86400

# Delay the first background check after container startup in seconds.
CODE_SERVER_UPDATE_INITIAL_DELAY_SECONDS=300

# Code Server (VS Code in browser) settings
# Port on host to map to container's code-server port (8080)
CODE_SERVER_PORT=8080

# Authentication: password or none
CODE_SERVER_AUTH=password

# Password for code-server (default: devbox)
CODE_SERVER_PASSWORD=devbox

# Optional pinned GitHub Copilot extension versions.
# Keep these as latest to auto-resolve the newest version compatible with the
# current code-server / VS Code build.
COPILOT_VERSION=latest
COPILOT_CHAT_VERSION=latest

# SSH remote access settings
# Port on host to map to container's SSH port (22)
SSH_PORT=2222

# Host SSH directory to mount into the container (read-only).
# Leave empty or unset to use the default (~/.ssh).
HOST_SSH_DIR=~/.ssh

# SSH public key for authentication (recommended)
# Paste your public key content here, e.g.: ssh-rsa AAAAB3... user@host
SSH_PUBLIC_KEY=

# Or use SSH key file path (alternative to SSH_PUBLIC_KEY)
# SSH_KEY_PATH=~/.ssh/id_rsa.pub

# Claude Code telemetry (OTEL_RESOURCE_ATTRIBUTES user.name is URL-encoded)
OTEL_RESOURCE_ATTRIBUTES=user.name=%E5%AD%90%E7%89%99

# Git identity used inside the devbox container
GIT_USER_NAME=
GIT_USER_EMAIL=

# Dev container user settings
# 默认使用 root；如需非 root，可设置例如:
# DEV_USER=vscode
# DEV_HOME=/home/vscode
DEV_USER=root
DEV_HOME=/root
DEV_UID=0
DEV_GID=0
DEV_GRANT_SUDO=true

# ------------------------------------------------------------------------------
# Model API Configuration
# Leave URL empty to use the official default endpoint.
# ------------------------------------------------------------------------------

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=

# Kimi Code 2.5 (Moonshot)
KIMI_CODE_API_KEY=
KIMI_CODE_API_URL=

# Claude Code (Anthropic)
# By default the container routes Claude through the local codewiz proxy (see below).
# To use the official Anthropic API instead, set ANTHROPIC_API_KEY to a real key and
# set ANTHROPIC_BASE_URL=https://api.anthropic.com (or leave it empty for the default).
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ChatGPT Codex (OpenAI)
# By default the container routes Codex through the local codewiz proxy (see below).
# To use the official OpenAI API instead, set OPENAI_API_KEY to a real key and
# set OPENAI_BASE_URL=https://api.openai.com/v1 (or leave it empty for the default).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Codewiz Proxy — XHS internal LLM adapter for Claude Code and Codex
# Priority: env vars below > ~/.local/share/codewiz/auth.json (persisted in /root volume)
# Leave empty if you use auth.json (populated via `codewiz login` on the host).
CODEWIZ_SESSION_TOKEN=
CODEWIZ_USER_EMAIL=
