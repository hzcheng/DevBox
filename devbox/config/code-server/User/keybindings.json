// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+cmd+u",
        "command": "workbench.view.extension.containersView",
        "when": "viewContainer.workbench.view.extension.containersView.enabled"
    },
    {
        "key": "ctrl+cmd+g",
        "command": "workbench.view.scm",
        "when": "workbench.scm.active"
    },
    {
        "key": "shift+cmd+r",
        "command": "workbench.files.action.showActiveFileInExplorer"
    },
    {
        "key": "ctrl+z",
        "command": "workbench.action.toggleMaximizedPanel",
        "when": "panelAlignment == 'center' || panelPosition != 'bottom' && panelPosition != 'top'"
    },
    {
        "key": "ctrl+w",
        "command": "workbench.action.closeActiveEditor"
    },
    {
        "key": "cmd+s",
        "command": "extension.multiCommand.execute",
        "args": {
            "sequence": [
                "extension.vim_escape",
                "workbench.action.files.save",
            ]
        },
        "when": "editorTextFocus && vim.active && !inDebugRepl"
    },
    {
        "key": "ctrl+cmd+y",
        "command": "workbench.action.terminal.runSelectedText",
        "when": "terminalProcessSupported"
    },
    {
        "key": "shift+cmd+b",
        "command": "workbench.action.toggleAuxiliaryBar"
    },
    {
        "key": "cmd+m",
        "command": "workbench.action.terminal.focusNext",
        "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
    },
    {
        "key": "shift+cmd+m",
        "command": "workbench.action.terminal.focusPrevious",
        "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
    },
    {
        "key": "ctrl+cmd+b",
        "command": "cmake.build",
        "when": "cmake:enableFullFeatureSet && !cmake:hideBuildCommand"
    },
    {
        "key": "ctrl+cmd+s",
        "command": "git.stageAll",
        "when": "!operationInProgress"
    },
    {
        "key": "ctrl+shift+]",
        "command": "editor.action.revealDefinitionAside",
        "when": "editorHasDefinitionProvider && !isInEmbeddedEditor"
    },
    {
        "key": "space",
        "command": "jump-extension.jump-to-the-start-of-a-word",
        "when": "editorTextFocus && vim.active && vim.mode == Normal"
    },
]