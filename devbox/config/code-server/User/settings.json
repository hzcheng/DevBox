{
    "workbench.iconTheme": "vscode-icons",
    "terminal.integrated.macOptionIsMeta": true,

    // Kimi Code 配置
    "kimi.yoloMode": false,
    "kimi.autosave": true,
    "kimi.enableNewConversationShortcut": true,
    "kimi.useCtrlEnterToSend": false,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "containers.images.groupBy": "Registry",
    "containers.images.label": "RepositoryNameAndTag",

    "terminal.integrated.copyOnSelection": true,
    "remote.autoForwardPortsSource": "hybrid",
    "git.confirmSync": false,
    "workbench.startupEditor": "none",
    "workbench.secondarySideBar.showLabels": false,

    "workbench.colorTheme": "Quiet Light",
    "terminal.integrated.initialHint": false,
    "claudeCode.preferredLocation": "panel",
    "workbench.panel.showLabels": false,
    "vim.useSystemClipboard": true,
    "terminal.integrated.macOptionClickForcesSelection": true,
    "containers.containers.label": "ContainerName",
    "chat.viewSessions.orientation": "stacked",
    "chat.agentsControl.enabled": false,
    "diffEditor.renderSideBySide": true,
    "diffEditor.experimental.showMoves": true,
    "githubPullRequests.hideViewedFiles": false,
}